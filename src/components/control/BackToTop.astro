---
import { Icon } from "astro-icon/components";
---
<!-- 1. 移除手机端隐藏限制：将 hidden lg:block 改为 block，全屏幕显示 -->
<div class="back-to-top-wrapper block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center justify-center rounded-2xl overflow-visible transition" onclick="backToTop()">
        <!-- 按钮主体：保持语义化，适配手机触摸区域 -->
        <button aria-label="Back to Top" class="btn-card h-[2.5rem] w-[2.5rem] rounded-2xl relative flex flex-col items-center justify-center">
            <!-- 圆角矩形进度条 SVG：缩小尺寸适配手机 -->
            <svg class="progress-ring" width="40" height="40" viewBox="0 0 40 40">
                <!-- 背景矩形（遮罩层） -->
                <rect
                    class="progress-ring-bg"
                    x="1.5"
                    y="1.5"
                    width="37"  <!-- 按比例缩小（原57→37） -->
                    height="37" <!-- 按比例缩小（原57→37） -->
                    rx="10"    <!-- 圆角按比例缩小（原16→10） -->
                    fill="none"
                    stroke-width="2.5" <!-- 线条变细（原3.1→2.5） -->
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
                <!-- 进度矩形：更新周长相关参数 -->
                <rect
                    id="progress-ring-path"
                    class="progress-ring-path"
                    x="1.5"
                    y="1.5"
                    width="37"
                    height="37"
                    rx="10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2" <!-- 线条变细（原3→2.2） -->
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-dasharray="130.6" <!-- 新周长：4*(37-2*10) + 2π*10 ≈ 130.6 -->
                    stroke-dashoffset="130.6"
                    opacity="0"
                />
            </svg>
            
            <!-- 上升图标：缩小尺寸，确保触摸不遮挡 -->
            <div id="back-to-top-icon" class="icon-wrapper relative z-10 transition-all duration-300 flex items-center justify-center">
                <Icon name="material-symbols:keyboard-arrow-up-rounded" class="text-[1.5rem]" /> <!-- 图标缩小（原2.25rem→1.5rem） -->
            </div>
            <!-- 进度百分比标签：缩小字体，适配手机视觉 -->
            <div id="back-to-top-progress-label" class="progress-label relative z-10 opacity-0 transition-all duration-300 text-[0.75rem] font-medium flex items-center justify-center">
                <span id="back-to-top-progress-text">0%</span>
            </div>
        </button>
    </div>
</div>

<style lang="stylus">
/* 容器：适配手机尺寸，避免占用过多空间 */
.back-to-top-wrapper
    width: 2.5rem  /* 缩小（原3.75rem→2.5rem） */
    height: 2.5rem /* 缩小（原3.75rem→2.5rem） */
    position: absolute
    right: 0
    top: 0
    pointer-events: none

/* 按钮核心样式：优化手机触摸体验 */
.back-to-top-btn
    color: var(--primary)
    font-size: 1.5rem /* 缩小（原2.25rem→1.5rem） */
    font-weight: bold
    border: none
    position: fixed
    bottom: 1rem  /* 减少底部间距（原2rem→1rem），避免遮挡手机底部导航 */
    right: 1rem   /* 减少右侧间距（原2rem→1rem），适配手机窄屏 */
    opacity: 1
    cursor: pointer
    transform: translateX(0)
    pointer-events: auto
    z-index: 100 /* 确保在其他元素上方，不被遮挡 */
    background: transparent
    
    /* 按钮内部容器：匹配外层尺寸 */
    button
        position: relative
        border-radius: 0.8rem /* 圆角缩小（原1rem→0.8rem） */
        
    /* 进度环：适配缩小后的按钮 */
    .progress-ring
        position: absolute
        top: 50%
        left: 50%
        transform: translate(-50%, -50%)
        width: 40px  /* 缩小（原60px→40px） */
        height: 40px /* 缩小（原60px→40px） */
        pointer-events: none
        z-index: 0
        
    /* 进度环背景：保持与页面背景协调 */
    .progress-ring-bg
        stroke: var(--page-bg)
        
    /* 进度环动画：保留原过渡效果 */
    .progress-ring-path
        transition: stroke-dashoffset 0.3s ease-out, opacity 0.3s ease-out
        
    /* 图标容器：调整位置，适配标签显示 */
    .icon-wrapper
        transition: transform 0.3s ease-out
        position: absolute
        top: 50%
        left: 50%
        transform: translate(-50%, -50%)
        
    /* 进度显示时的图标位置：微调间距（原0.5rem→0.3rem） */
    .icon-wrapper.show-progress
        transform: translate(-50%, calc(-50% - 0.3rem))
        
    /* 进度标签：优化手机端字体和位置 */
    .progress-label
        color: var(--primary)
        transition: opacity 0.3s ease-out, transform 0.3s ease-out
        position: absolute
        top: 50%
        left: 50%
        transform: translate(-50%, calc(-50% + 0.3rem)) /* 微调间距（原0.5rem→0.3rem） */
        opacity: 0
        font-size: 0.75rem /* 缩小字体（原默认→0.75rem） */
        
    /* 标签显示状态：保持原过渡 */
    .progress-label.show
        opacity: 1
        transform: translate(-50%, calc(-50% + 0.3rem))
        
    /* 标签隐藏状态：微调动画 */
    .progress-label.hide-up
        opacity: 0
        transform: translate(-50%, calc(-50% - 0.3rem))
        
    /* 图标：确保尺寸统一 */
    i
        font-size: 1.5rem /* 缩小（原1.75rem→1.5rem） */
        
    /* 按钮隐藏状态：保留原动画 */
    &.hide
        transform: translateX(0) scale(0.9)
        opacity: 0
        pointer-events: none
        
    /* 按钮点击反馈：适配手机触摸（保留缩放效果） */
    &:active
        transform: translateX(0) scale(0.9)
</style>

<!-- 脚本：功能逻辑不变，无需适配（滚动、进度计算对手机端通用） -->
<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
(function() {
    let scrollTimeout = null;
    let lastScrollTime = 0;
    const HIDE_DELAY = 3000; // 3秒后隐藏进度标签（手机端无需修改）
    const SCROLL_THRESHOLD_PX = 300; // 降低触发阈值（原500→300），适配手机短屏
    
    const progressPath = document.getElementById('progress-ring-path');
    const progressText = document.getElementById('back-to-top-progress-text');
    const progressLabel = document.getElementById('back-to-top-progress-label');
    const iconWrapper = document.getElementById('back-to-top-icon');
    const backToTopBtn = document.getElementById('back-to-top-btn');
    
    if (!progressPath || !progressText || !progressLabel || !iconWrapper || !backToTopBtn) {
        return;
    }
    
    // 关键：更新手机端进度环周长（对应SVG尺寸调整）
    const perimeter = 130.6; // 新周长：4*(37-2*10) + 2π*10 ≈ 130.6
    let currentProgress = 0;
    let isProgressVisible = false;
    let lastScrollTop = 0;
    
    function updateProgress() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const postContainer = document.getElementById('post-container');
        
        let progress = 0;
        
        // 保留原逻辑：优先计算文章容器进度，无则计算整页进度
        if (postContainer) {
            const containerRect = postContainer.getBoundingClientRect();
            const containerTop = containerRect.top + window.pageYOffset;
            const containerBottom = containerTop + containerRect.height;
            const containerHeight = containerRect.height;
            const viewportHeight = window.innerHeight;
            const scrollableDistance = Math.max(0, containerBottom - containerTop - viewportHeight);
            
            if (scrollableDistance > 0) {
                const scrolledDistance = scrollTop - containerTop;
                progress = Math.round((scrolledDistance / scrollableDistance) * 100);
                progress = Math.max(0, Math.min(100, progress));
            } else {
                progress = scrollTop >= containerTop ? 100 : 0;
            }
        } else {
            progress = scrollHeight > 0 ? Math.min(100, Math.round((scrollTop / scrollHeight) * 100)) : 0;
        }
        
        // 更新进度环（使用新周长）
        const offset = perimeter - (progress / 100) * perimeter;
        progressPath.style.strokeDashoffset = offset.toString();
        progressText.textContent = progress + '%';
        
        const isScrolling = scrollTop !== lastScrollTop;
        const shouldShowButton = scrollTop >= SCROLL_THRESHOLD_PX;
        
        lastScrollTop = scrollTop;
        
        // 按钮显示/隐藏逻辑（手机端通用）
        if (shouldShowButton) {
            backToTopBtn.classList.remove('hide');
            if (isScrolling) {
                clearTimeout(scrollTimeout);
                if (!isProgressVisible) {
                    isProgressVisible = true;
                    progressPath.style.opacity = '1';
                    progressLabel.classList.remove('hide-up');
                    progressLabel.classList.add('show');
                    iconWrapper.classList.add('show-progress');
                }
                currentProgress = progress;
                scrollTimeout = setTimeout(() => {
                    hideProgressLabel();
                }, HIDE_DELAY);
            }
        } else {
            backToTopBtn.classList.add('hide');
            if (isProgressVisible) {
                isProgressVisible = false;
                progressPath.style.opacity = '0';
                progressLabel.classList.remove('show', 'hide-up');
                iconWrapper.classList.remove('show-progress');
            }
            clearTimeout(scrollTimeout);
        }
    }
    
    function hideProgressLabel() {
        if (isProgressVisible) {
            isProgressVisible = false;
            progressLabel.classList.remove('show');
            progressLabel.classList.add('hide-up');
            iconWrapper.classList.remove('show-progress');
        }
    }
    
    // 滚动监听：使用requestAnimationFrame优化性能（手机端流畅）
    let ticking = false;
    function onScroll() {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                updateProgress();
                ticking = false;
            });
            ticking = true;
        }
        lastScrollTime = Date.now();
    }
    
    window.addEventListener('scroll', onScroll, { passive: true });
    lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
    updateProgress();
})();
</script>