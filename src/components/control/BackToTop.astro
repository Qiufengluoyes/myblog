---
import { Icon } from "astro-icon/components";
---

<div class="back-to-top-wrapper">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center justify-center rounded-2xl overflow-visible transition" onclick="backToTop()">
        <!-- 按钮主体 -->
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem] rounded-2xl relative flex flex-col items-center justify-center">
            <!-- 圆角矩形进度条 SVG -->
            <svg class="progress-ring" width="60" height="60" viewBox="0 0 60 60">
                <!-- 背景矩形（遮罩层，显示未涉及的部分） -->
                <rect
                    class="progress-ring-bg"
                    x="1.5"
                    y="1.5"
                    width="57"
                    height="57"
                    rx="16"
                    fill="none"
                    stroke-width="3.1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                />
                <!-- 进度矩形 -->
                <rect
                    id="progress-ring-path"
                    class="progress-ring-path"
                    x="1.5"
                    y="1.5"
                    width="57"
                    height="57"
                    rx="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-dasharray="200.53"
                    stroke-dashoffset="200.53"
                    opacity="0"
                />
            </svg>
            
            <!-- 上升图标 -->
            <div id="back-to-top-icon" class="icon-wrapper relative z-10 transition-all duration-300 flex items-center justify-center">
                <Icon name="material-symbols:keyboard-arrow-up-rounded"></Icon>
            </div>
            <!-- 进度百分比标签 -->
            <div id="back-to-top-progress-label" class="progress-label relative z-10 opacity-0 transition-all duration-300 text-xs font-medium flex items-center justify-center hidden md:flex">
                <span id="back-to-top-progress-text">0%</span>
            </div>
            <!-- 手机端百分比标签 -->
            <div id="back-to-top-progress-label-mobile" class="progress-label-mobile relative z-10 opacity-0 transition-all duration-300 text-[10px] font-bold flex items-center justify-center">
                <span id="back-to-top-progress-text-mobile">0%</span>
            </div>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none
    
    // 手机端调整
    @media (max-width: 1023px)
        width: 3.5rem
        height: 3.5rem
        right: 1rem
        bottom: 1rem
        top: auto

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    bottom: 2rem
    right: 2rem
    opacity: 1
    cursor: pointer
    transform: translateY(0)
    pointer-events: auto
    z-index: 100
    background: transparent
    width: fit-content
    height: fit-content
    padding: 0
    transition: transform 0.3s ease-out, opacity 0.3s ease-out
    
    // 手机端位置调整
    @media (max-width: 1023px)
        bottom: 1rem
        right: 1rem
    
    button
        position: relative
        border-radius: 1rem
        width: 3.75rem
        height: 3.75rem
        
        @media (max-width: 1023px)
            width: 3.5rem
            height: 3.5rem
        
    .progress-ring
        position: absolute
        top: 50%
        left: 50%
        transform: translate(-50%, -50%)
        width: 60px
        height: 60px
        pointer-events: none
        z-index: 0
        
        // 手机端缩小进度条
        @media (max-width: 1023px)
            width: 48px
            height: 48px
        
    .progress-ring-bg
        stroke: var(--page-bg)
        
    .progress-ring-path
        transition: stroke-dashoffset 0.3s ease-out, opacity 0.3s ease-out
        
    .icon-wrapper
        transition: transform 0.3s ease-out
        position: absolute
        top: 50%
        left: 50%
        transform: translate(-50%, -50%)
        font-size: 2.25rem
        
        @media (max-width: 1023px)
            font-size: 1.25rem
            transform: translate(-50%, calc(-50% - 0.35rem))
        
    .icon-wrapper.show-progress
        transform: translate(-50%, calc(-50% - 0.5rem))
        
        @media (max-width: 1023px)
            transform: translate(-50%, calc(-50% - 0.35rem))
        
    .progress-label
        color: var(--primary)
        transition: opacity 0.3s ease-out, transform 0.3s ease-out
        position: absolute
        top: 50%
        left: 50%
        transform: translate(-50%, calc(-50% + 0.5rem))
        opacity: 0
        
    .progress-label.show
        opacity: 1
        transform: translate(-50%, calc(-50% + 0.5rem))
        
    .progress-label.hide-up
        opacity: 0
        transform: translate(-50%, calc(-50% + 0.5rem))
    
    // 手机端百分比标签：放在箭头下方，优化位置
    .progress-label-mobile
        color: var(--primary)
        transition: opacity 0.3s ease-out
        position: absolute
        top: 50%
        left: 50%
        transform: translate(-50%, calc(-50% + 0.65rem))
        opacity: 0
        
        // 桌面端隐藏
        @media (min-width: 1024px)
            display: none
        
    .progress-label-mobile.show
        opacity: 1
        
    .progress-label-mobile.hide-up
        opacity: 0
        
    &.hide
        transform: translateY(2rem)
        opacity: 0
        pointer-events: none
        
    &:active:not(.hide)
        filter: brightness(0.95)

</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}

(function() {
    let scrollTimeout = null;
    let lastScrollTime = 0;
    const HIDE_DELAY = 3000; // 3秒
    const SCROLL_THRESHOLD_PX = 500; // 固定px阈值，超过此值显示按钮
    
    // 判断是否为移动设备
    const isMobile = () => window.innerWidth < 1024;
    
    const progressPath = document.getElementById('progress-ring-path');
    const progressText = document.getElementById('back-to-top-progress-text');
    const progressLabel = document.getElementById('back-to-top-progress-label');
    const iconWrapper = document.getElementById('back-to-top-icon');
    const progressLabelMobile = document.getElementById('back-to-top-progress-label-mobile');
    const progressTextMobile = document.getElementById('back-to-top-progress-text-mobile');
    const backToTopBtn = document.getElementById('back-to-top-btn');
    
    if (!progressPath || !progressText || !progressLabel || !iconWrapper || !backToTopBtn || !progressLabelMobile || !progressTextMobile) {
        return;
    }
    
    const perimeter = 200.53;
    let currentProgress = 0;
    let isProgressVisible = false;
    let lastScrollTop = 0;
    
    function updateProgress() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const postContainer = document.getElementById('post-container');
        
        let progress = 0;
        
        if (postContainer) {
            const containerRect = postContainer.getBoundingClientRect();
            const containerTop = containerRect.top + window.pageYOffset;
            const containerBottom = containerTop + containerRect.height;
            const containerHeight = containerRect.height;
            const viewportHeight = window.innerHeight;
            const scrollableDistance = Math.max(0, containerBottom - containerTop - viewportHeight);
            
            if (scrollableDistance > 0) {
                const scrolledDistance = scrollTop - containerTop;
                progress = Math.round((scrolledDistance / scrollableDistance) * 100);
                progress = Math.max(0, Math.min(100, progress));
            } else {
                if (scrollTop >= containerTop) {
                    progress = 100;
                } else {
                    progress = 0;
                }
            }
        } else {
            progress = scrollHeight > 0 ? Math.min(100, Math.round((scrollTop / scrollHeight) * 100)) : 0;
        }
        
        const offset = perimeter - (progress / 100) * perimeter;
        progressPath.style.strokeDashoffset = offset.toString();
        progressText.textContent = progress + '%';
        progressTextMobile.textContent = progress + '%';
        
        const isScrolling = scrollTop !== lastScrollTop;
        const shouldShowButton = scrollTop >= SCROLL_THRESHOLD_PX;
        lastScrollTop = scrollTop;
        
        if (shouldShowButton) {
            backToTopBtn.classList.remove('hide');
            
            if (isScrolling) {
                clearTimeout(scrollTimeout);
                
                if (!isProgressVisible) {
                    isProgressVisible = true;
                    progressPath.style.opacity = '1';
                    
                    // 桌面端：显示百分比标签和图标移动
                    if (!isMobile()) {
                        progressLabel.classList.remove('hide-up');
                        progressLabel.classList.add('show');
                        iconWrapper.classList.add('show-progress');
                    } else {
                        // 手机端：只显示百分比
                        progressLabelMobile.classList.remove('hide-up');
                        progressLabelMobile.classList.add('show');
                    }
                }
                
                currentProgress = progress;
                
                // 移动端：更长的隐藏延迟，增加用户可见时间
                const hideDelay = isMobile() ? 4000 : HIDE_DELAY;
                scrollTimeout = setTimeout(() => {
                    hideProgressLabel();
                }, hideDelay);
            }
        } else {
            backToTopBtn.classList.add('hide');
            if (isProgressVisible) {
                isProgressVisible = false;
                progressPath.style.opacity = '0';
                progressLabel.classList.remove('show', 'hide-up');
                progressLabelMobile.classList.remove('show', 'hide-up');
                iconWrapper.classList.remove('show-progress');
            }
            clearTimeout(scrollTimeout);
        }
    }
    
    function hideProgressLabel() {
        if (isProgressVisible) {
            isProgressVisible = false;
            progressLabel.classList.remove('show');
            progressLabel.classList.add('hide-up');
            progressLabelMobile.classList.remove('show');
            progressLabelMobile.classList.add('hide-up');
            iconWrapper.classList.remove('show-progress');
        }
    }
    
    let ticking = false;
    function onScroll() {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                updateProgress();
                ticking = false;
            });
            ticking = true;
        }
        lastScrollTime = Date.now();
    }
    
    window.addEventListener('scroll', onScroll, { passive: true });
    
    lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
    updateProgress();
})();
</script>
