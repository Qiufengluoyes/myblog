---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import { siteConfig } from "../../config";
import { url } from "../../utils/url-utils";

const { id, src, alt, position = "center", basePath = "/" } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();
}

const imageClass = "w-full h-full object-cover image-content";
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative image-wrapper', className?.includes('banner') ? 'banner-image' : '']} style={`--theme-hue: ${siteConfig.themeColor.hue}`} data-image-wrapper>
    <!-- 加载条 -->
    <div class="loading-bar">
        <div class="loading-progress"></div>
    </div>
    
    <!-- 图片内容 -->
    <div class="image-container">
        {isLocal && img && <Image src={img} alt={alt || ""} class={imageClass} style={imageStyle} loading="eager" data-image-element />}
        {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={imageClass} style={imageStyle} loading="eager" data-image-element />}
    </div>
    <div class="image-overlay">
        <div class="overlay-mask pointer-events-none"></div>
    </div>
</div>

<script>
    interface AnimationState {
        lastGlobalTime?: number;
        lastPath?: string;
    }

    class ImageAnimationController {
        static readonly storageKey = 'imageAnimationState';
        static readonly cooldownTime = 5000; // 5秒冷却时间

        static getState(): AnimationState {
            try {
                return JSON.parse(sessionStorage.getItem(this.storageKey) || '{}');
            } catch {
                return {};
            }
        }

        static setState(state: AnimationState): void {
            sessionStorage.setItem(this.storageKey, JSON.stringify(state));
        }

        static shouldShowAnimation(): boolean {
            const state = this.getState();
            const now = Date.now();
            const path = window.location.pathname;

            // 检查全局状态
            if (!state.lastGlobalTime || (now - state.lastGlobalTime) > this.cooldownTime) {
                state.lastGlobalTime = now;
                state.lastPath = path;
                this.setState(state);
                return true;
            }

            // 检查路径变化
            if (state.lastPath !== path) {
                // 即使路径改变，也要遵守冷却时间
                state.lastPath = path;
                this.setState(state);
                return false;
            }

            return false;
        }

        static init(): void {
            // 确保只初始化一次
            if ((window as any).__imageAnimationInitialized) return;
            (window as any).__imageAnimationInitialized = true;

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', () => this.handleAnimation());
            } else {
                this.handleAnimation();
            }

            // 监听 astro:page-load 事件，处理 view transitions
            document.addEventListener('astro:page-load', () => {
                this.handleAnimation();
            });

            // 监听 astro:after-swap 事件，确保在视图转换后正确处理
            document.addEventListener('astro:after-swap', () => {
                this.handleAnimation();
            });
        }

        static handleAnimation(): void {
            const wrappers = document.querySelectorAll<HTMLElement>('[data-image-wrapper]');
            if (!wrappers.length) return;

            const shouldAnimate = this.shouldShowAnimation();
            
            wrappers.forEach(wrapper => {
                if (shouldAnimate) {
                    if (!wrapper.classList.contains('show-animation')) {
                        wrapper.classList.add('show-animation');
                    }
                } else {
                    wrapper.classList.remove('show-animation');
                    const imageContent = wrapper.querySelector<HTMLElement>('.image-content');
                    if (imageContent) {
                        imageContent.style.opacity = '1';
                        imageContent.style.visibility = 'visible';
                    }
                }
            });
        }
    }

    // 初始化控制器
    ImageAnimationController.init();
</script>

<style>
    /* 基础样式 */
    .loading-bar {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 8rem;
        height: 0.25rem;
        background-color: rgba(156, 163, 175, 0.2);
        z-index: 10;
        border-radius: 9999px;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        backdrop-filter: blur(4px);
        transition: opacity 0.3s ease-out, visibility 0.3s ease-out;
        transform-origin: center;
    }

    .loading-progress {
        height: 100%;
        width: 2rem;
        background-color: oklch(0.70 0.14 var(--theme-hue));
        border-radius: 9999px;
        box-shadow: 0 0 10px oklch(0.70 0.14 var(--theme-hue) / 0.3);
    }
    
    .image-content {
        opacity: 0;
        visibility: hidden;
        transition: all 0.5s ease-out;
        will-change: opacity, visibility, transform;
    }

    .image-container {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        z-index: 2;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        transition: all 0.5s ease-out;
        will-change: opacity, visibility;
    }

    .overlay-mask {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.02) 100%);
        transition: opacity 0.3s ease-out;
    }

    :global(.dark) .overlay-mask {
        background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.1) 100%);
    }
    
    /* 暗色模式样式 */
    :global(.dark) .loading-bar {
        background-color: rgba(75, 85, 99, 0.3);
    }
    
    /* 非动画状态（默认状态）*/
    :global(:not(.show-animation)) .image-content {
        opacity: 1;
        visibility: visible;
    }

    :global(:not(.show-animation)) .image-overlay {
        opacity: 1;
        visibility: visible;
    }
    
    /* 动画状态样式 */
    :global(.show-animation) .loading-bar {
        opacity: 1;
        visibility: visible;
        animation: loading-bar-fade 2.4s ease-in-out forwards;
    }
    
    :global(.show-animation) .loading-progress {
        animation: loading-progress 1.125s ease-in-out 2;
        position: relative;
        z-index: 1;
    }
    
    :global(.show-animation) .image-content {
        opacity: 0;
        visibility: hidden;
        animation: image-fade-in 0.5s ease-out 2.4s forwards;
    }

    :global(.show-animation) .image-overlay {
        opacity: 0;
        visibility: hidden;
        animation: overlay-fade-in 0.5s ease-out 2.4s forwards;
    }
    
    /* 动画关键帧 */
    @keyframes loading-progress {
        0% {
            transform: translateX(-100%);
        }
        100% {
            transform: translateX(400%);
        }
    }
    
    @keyframes loading-bar-fade {
        0%, 85% {
            opacity: 1;
            transform: translate(-50%, -50%);
            background-color: rgba(156, 163, 175, 0.2);
            filter: blur(0);
        }
        90% {
            opacity: 0.95;
            transform: translate(-50%, -49%);
            background-color: rgba(156, 163, 175, 0.18);
            filter: blur(0.3px);
        }
        95% {
            opacity: 0.6;
            transform: translate(-50%, -48%);
            background-color: rgba(156, 163, 175, 0.12);
            filter: blur(0.8px);
        }
        97% {
            opacity: 0.3;
            transform: translate(-50%, -47.5%);
            background-color: rgba(156, 163, 175, 0.06);
            filter: blur(1.2px);
        }
        100% {
            opacity: 0;
            transform: translate(-50%, -47%);
            background-color: rgba(156, 163, 175, 0);
            filter: blur(1.5px);
        }
    }
    
    :global(.dark) .loading-bar {
        animation-name: loading-bar-fade-dark;
    }
    
    @keyframes loading-bar-fade-dark {
        0%, 85% {
            opacity: 1;
            transform: translate(-50%, -50%);
            background-color: rgba(75, 85, 99, 0.3);
            filter: blur(0);
        }
        90% {
            opacity: 0.95;
            transform: translate(-50%, -49%);
            background-color: rgba(75, 85, 99, 0.25);
            filter: blur(0.3px);
        }
        95% {
            opacity: 0.6;
            transform: translate(-50%, -48%);
            background-color: rgba(75, 85, 99, 0.15);
            filter: blur(0.8px);
        }
        97% {
            opacity: 0.3;
            transform: translate(-50%, -47.5%);
            background-color: rgba(75, 85, 99, 0.08);
            filter: blur(1.2px);
        }
        100% {
            opacity: 0;
            transform: translate(-50%, -47%);
            background-color: rgba(75, 85, 99, 0);
            filter: blur(1.5px);
        }
    }
    
    @keyframes image-fade-in {
        0% {
            opacity: 0;
            visibility: hidden;
            transform: scale(1.02);
        }
        100% {
            opacity: 1;
            visibility: visible;
            transform: scale(1);
        }
    }

    @keyframes overlay-fade-in {
        0% {
            opacity: 0;
            visibility: hidden;
        }
        50% {
            opacity: 0.7;
            visibility: visible;
        }
        100% {
            opacity: 1;
            visibility: visible;
        }
    }
    
    /* 悬停效果 */
    .image-wrapper:not(#banner):hover .image-content {
        transform: scale(1.05);
    }
</style>